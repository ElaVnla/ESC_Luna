{
  "extends": "./Frontend/tsconfig.app.json",
  "compilerOptions": {
    "types": ["cypress", "node", "cypress-real-events"],
    "allowJs": true,

    "baseUrl": "./Frontend",
    "paths": {
      "@/*": ["./Frontend/src/*"]
    },

    "noEmit": true
  },
  "include": [
    "cypress/**/*.ts",
    "cypress/**/*.tsx",
    "cypress/**/*.js",
    "cypress.config.ts"
  ]
}
